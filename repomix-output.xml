		close(ch)
		return ch, nil
	}

	if tools != nil {
		close(ch)
		return ch, nil
	}

	ch <- models.StreamEvent{Type: "content", Content: "final wrapped answer"}
	ch <- models.StreamEvent{Type: "stop"}
	close(ch)
	return ch, nil
}

