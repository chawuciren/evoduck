* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    background:
        linear-gradient(var(--body-grid) 1px, transparent 1px),
        linear-gradient(90deg, var(--body-grid) 1px, transparent 1px),
        linear-gradient(180deg, var(--body-glow-top) 0%, rgba(var(--theme-shadow-hard-rgb), 0) 28%),
        radial-gradient(circle at top, var(--body-radial), transparent 35%),
        var(--body-background);
    background-size: 24px 24px, 24px 24px, 100% 100%, 100% 100%, 100% 100%;
    color: var(--text-main);
    height: 100vh;
    width: 100vw;
    overflow: hidden;
    letter-spacing: 0.02em;
    text-rendering: optimizeLegibility;
}

.brand-pixel {
    font-family: "Courier New", "Consolas", monospace;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-weight: 800;
    line-height: 1.05;
    text-shadow:
        1px 0 0 rgba(var(--accent-rgb), 0.32),
        0 1px 0 rgba(var(--accent-rgb), 0.32),
        2px 2px 0 rgba(var(--theme-shadow-hard-rgb), 0.92),
        0 0 18px rgba(var(--accent-rgb), 0.18);
    -webkit-font-smoothing: none;
    font-smooth: never;
    image-rendering: pixelated;
}

.terminal-header .brand-pixel {
    display: inline-block;
    letter-spacing: 0.14em;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: repeating-linear-gradient(
        180deg,
        var(--body-scanline) 0,
        var(--body-scanline) 1px,
        transparent 1px,
        transparent 4px
    );
    opacity: var(--body-overlay-opacity);
    z-index: 9999;
}

/* ===== Shared Header & Status ===== */
.page-header::before,
.sidebar-header::before,
.right-panel-section::before,
.connection-box::before,
.agent-card::before,
.skill-card::before,
.session-item::before,
.knowledge-item::before,
.settings-section::before,
.tool-call-card::before,
.thinking-card::before,
.log-container::before {
    content: "";
    position: absolute;
    inset: 7px;
    border: 1px solid rgba(var(--accent-rgb), 0.08);
    pointer-events: none;
}

.status {
    font-size: 12px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--theme-status-surface);
    border: 1px solid var(--line);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--text-soft);
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px rgba(var(--accent-2-rgb), 0.08);
}

.status.connected {
    background: var(--theme-status-online-surface);
    box-shadow: 0 0 18px rgba(var(--accent-rgb), 0.18);
    color: var(--accent);
    border: 1px solid var(--line-strong);
}

.status.connected::before {
    content: "online · ";
}

.status.disconnected {
    background: var(--theme-status-offline-surface);
    border: 1px solid rgba(var(--danger-rgb), 0.35);
    color: var(--accent-danger);
}

.status.disconnected::before {
    content: "offline · ";
}

/* ===== Sidebar ===== */
.sidebar {
    width: 260px;
    height: 100vh;
    background: var(--sidebar-surface);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    position: fixed;
    left: 0;
    top: 0;
    z-index: 100;
}

.sidebar-header {
    padding: 16px 10px 14px;
    background: var(--sidebar-header-surface);
    border-bottom: 1px solid var(--line);
    box-shadow: inset 0 -1px 0 rgba(var(--accent-2-rgb), 0.08);
    position: relative;
    overflow: hidden;
}

.sidebar-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
}

.duck-art {
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 7px;
    line-height: 1.15;
    color: #FFD700;
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    white-space: pre;
    user-select: none;
    -webkit-user-select: none;
    text-align: left;
    letter-spacing: 0;
}

.evoduck-ascii {
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 5px;
    line-height: 1.1;
    color: rgba(53, 214, 255, 0.12);
    margin: 0;
    padding: 0;
    background: transparent;
    border: none;
    white-space: pre;
    user-select: none;
    -webkit-user-select: none;
    text-align: left;
    letter-spacing: 0;
}

.sidebar-nav {
    flex: 1;
    padding: 30px 16px 20px;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--sidebar-scrollbar-thumb) var(--sidebar-scrollbar-track);
}

.sidebar-nav::-webkit-scrollbar {
    width: var(--sidebar-scrollbar-size);
}

.sidebar-nav::-webkit-scrollbar-track {
    background: var(--sidebar-scrollbar-track);
}

.sidebar-nav::-webkit-scrollbar-thumb {
    background: var(--sidebar-scrollbar-thumb);
    border-radius: var(--sidebar-scrollbar-radius);
}

.sidebar-nav::-webkit-scrollbar-thumb:hover {
    background: var(--sidebar-scrollbar-thumb-hover);
}

.nav-section {
    margin-bottom: 32px;
}

.nav-section-title {
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 0.22em;
    font-weight: 700;
    margin-bottom: 16px;
    padding-left: 8px;
    text-transform: uppercase;
}

.nav-item {
    display: flex;
    align-items: center;
    padding: 15px 18px;
    margin-bottom: 8px;
    background: var(--theme-nav-surface);
    border: 1px solid var(--theme-nav-border);
    border-radius: 8px;
    color: var(--text-soft);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.08em;
    position: relative;
    text-transform: uppercase;
}

.nav-item::before {
    content: "";
    position: absolute;
    left: -1px;
    top: 7px;
    bottom: 7px;
    width: 3px;
    background: transparent;
}

.nav-item:hover {
    background: var(--theme-nav-hover-surface);
    border-color: rgba(var(--accent-rgb), 0.22);
    color: var(--text-main);
    transform: translateX(4px);
    box-shadow: 4px 4px 0 rgba(var(--theme-shadow-hard-rgb), 0.95), 0 0 20px rgba(var(--accent-rgb), 0.08);
}

.nav-item.active {
    background: var(--theme-nav-active-surface);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    color: var(--accent);
    box-shadow: 4px 4px 0 rgba(var(--theme-shadow-hard-rgb), 0.95), 0 0 20px rgba(var(--accent-rgb), 0.08);
}

.nav-item.active::before {
    background: linear-gradient(180deg, var(--accent) 0%, var(--accent-2) 100%);
}

.nav-icon {
    width: 24px;
    height: 24px;
    margin-right: 14px;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-2);
}

.nav-label-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
}

.nav-label {
    color: inherit;
    line-height: 1.1;
}

.nav-meta {
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.1;
}

.nav-item.active .nav-meta,
.nav-item:hover .nav-meta {
    color: color-mix(in srgb, var(--text-main) 72%, transparent);
}

.sidebar-footer {
    padding: 20px 24px;
    background: color-mix(in srgb, var(--panel) 72%, transparent);
    border-top: 1px solid rgba(var(--accent-rgb), 0.08);
}

.sidebar-footer-text {
    font-size: 10px;
    color: var(--text-dim);
    letter-spacing: 0.16em;
    text-align: center;
    text-transform: uppercase;
}

/* ===== Main Content ===== */
.main-content {
    width: calc(100vw - 260px - 232px);
    height: 100vh;
    background: var(--main-surface);
    display: flex;
    flex-direction: column;
    position: fixed;
    left: 260px;
    right: 232px;
    top: 0;
}

/* ===== Page Container ===== */
.page-container {
    width: 100%;
    height: 100%;
    display: none;
    flex-direction: column;
    position: relative;
}

.page-container.active {
    display: flex;
}

.page-header {
    background: var(--page-header-surface);
    color: var(--accent);
    padding: 26px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--line);
}

.page-header h1 {
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-shadow: 0 0 12px rgba(var(--accent-rgb), 0.15);
    color: var(--text-main);
    text-transform: uppercase;
}

.page-header h1::after {
    content: " _";
    color: rgba(var(--accent-rgb), 0.65);
}

.page-content {
    flex: 1;
    overflow-y: auto;
    padding: 36px 40px 40px;
    background: transparent;
    position: relative;
}

.page-content::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.025) 0%, transparent 20%, transparent 80%, rgba(var(--accent-2-rgb), 0.025) 100%);
    pointer-events: none;
}

.page-content::after {
    content: "";
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(var(--accent-2-rgb), 0.12) 20%, rgba(var(--accent-rgb), 0.12) 50%, rgba(var(--accent-2-rgb), 0.12) 80%, transparent 100%);
    pointer-events: none;
}

.page-content::-webkit-scrollbar {
    width: var(--content-scrollbar-size);
}

.page-content::-webkit-scrollbar-track {
    background: var(--content-scrollbar-track);
}

.page-content::-webkit-scrollbar-thumb {
    background: var(--content-scrollbar-thumb);
    border-radius: var(--content-scrollbar-radius);
    border: var(--content-scrollbar-thumb-border);
}

/* Shared content-area scrollbar treatment for page-level subpanels and editors. */
.command-dropdown::-webkit-scrollbar,
.tool-call-result-content::-webkit-scrollbar,
.thinking-content::-webkit-scrollbar,
.log-container::-webkit-scrollbar,
.knowledge-modal-content::-webkit-scrollbar,
.knowledge-editor-textarea::-webkit-scrollbar,
.knowledge-preview-content pre::-webkit-scrollbar,
.memory-preview-shell::-webkit-scrollbar,
.memory-preview-content::-webkit-scrollbar,
.settings-yaml-editor::-webkit-scrollbar,
.settings-json-editor::-webkit-scrollbar,
.schedule-textarea::-webkit-scrollbar,
.skill-content-preview::-webkit-scrollbar,
.diagnostics-table-shell::-webkit-scrollbar {
    width: var(--content-scrollbar-size);
    height: var(--content-scrollbar-size);
}

.command-dropdown::-webkit-scrollbar-track,
.tool-call-result-content::-webkit-scrollbar-track,
.thinking-content::-webkit-scrollbar-track,
.log-container::-webkit-scrollbar-track,
.knowledge-modal-content::-webkit-scrollbar-track,
.knowledge-editor-textarea::-webkit-scrollbar-track,
.knowledge-preview-content pre::-webkit-scrollbar-track,
.memory-preview-shell::-webkit-scrollbar-track,
.memory-preview-content::-webkit-scrollbar-track,
.settings-yaml-editor::-webkit-scrollbar-track,
.settings-json-editor::-webkit-scrollbar-track,
.schedule-textarea::-webkit-scrollbar-track,
.skill-content-preview::-webkit-scrollbar-track,
.diagnostics-table-shell::-webkit-scrollbar-track {
    background: var(--content-scrollbar-track);
}

.command-dropdown::-webkit-scrollbar-thumb,
.tool-call-result-content::-webkit-scrollbar-thumb,
.thinking-content::-webkit-scrollbar-thumb,
.log-container::-webkit-scrollbar-thumb,
.knowledge-modal-content::-webkit-scrollbar-thumb,
.knowledge-editor-textarea::-webkit-scrollbar-thumb,
.knowledge-preview-content pre::-webkit-scrollbar-thumb,
.memory-preview-shell::-webkit-scrollbar-thumb,
.memory-preview-content::-webkit-scrollbar-thumb,
.settings-yaml-editor::-webkit-scrollbar-thumb,
.settings-json-editor::-webkit-scrollbar-thumb,
.schedule-textarea::-webkit-scrollbar-thumb,
.skill-content-preview::-webkit-scrollbar-thumb,
.diagnostics-table-shell::-webkit-scrollbar-thumb {
    background: var(--content-scrollbar-thumb);
    border-radius: var(--content-scrollbar-radius);
    border: var(--content-scrollbar-thumb-border);
}

.terminal-header h1::before {
    content: "// ";
    color: var(--accent-2);
}

.page-header-actions {
    display: flex;
    gap: 16px;
    align-items: center;
    flex-wrap: wrap;
}

.header-chip {
    display: inline-flex;
    align-items: center;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--theme-chip-border);
    background: var(--theme-chip-surface);
    color: var(--accent-2);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px rgba(var(--accent-2-rgb), 0.04);
}

/* ===== Action Button ===== */
.action-btn {
    padding: 10px 20px;
    background: var(--theme-button-surface);
    color: var(--button-text);
    border: 1px solid var(--theme-button-border);
    border-radius: 8px;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--button-shadow);
    transition: all 0.2s;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.action-btn:hover {
    transform: translate(-1px, -1px);
    box-shadow: var(--theme-button-hover-shadow);
    color: var(--button-text-hover);
}

.action-btn-inline {
    margin-left: 12px;
    padding: 6px 12px;
    font-size: 12px;
}

/* ===== Card Base ===== */
.card {
    background: var(--card-surface);
    border: 1px solid rgba(var(--accent-rgb), 0.14);
    border-radius: var(--radius-panel);
    padding: 24px;
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-soft);
    transition: all 0.2s;
    position: relative;
}

.card:hover {
    border-color: rgba(var(--accent-rgb), 0.28);
    transform: translateY(-2px);
    box-shadow: var(--card-hover-shadow);
}

.card-title {
    font-size: 17px;
    color: var(--text-main);
    margin-bottom: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.card-subtitle {
    font-size: 12px;
    color: var(--text-soft);
    margin-bottom: 16px;
}

.card-content {
    color: color-mix(in srgb, var(--text-main) 88%, transparent);
    font-size: 14px;
    line-height: 1.7;
}

/* ===== Empty State ===== */
.empty-state {
    text-align: center;
    padding: 60px 40px;
    color: var(--text-dim);
    border: 1px dashed rgba(var(--accent-rgb), 0.12);
    border-radius: 10px;
    background: var(--theme-empty-surface);
    box-shadow: inset 0 0 0 1px rgba(var(--accent-2-rgb), 0.04);
    position: relative;
    overflow: hidden;
}

.empty-state::before {
    content: "system://awaiting-data";
    display: inline-block;
    margin-bottom: 14px;
    padding: 4px 10px;
    border: 1px solid rgba(var(--accent-2-rgb), 0.18);
    background: color-mix(in srgb, var(--panel-strong) 90%, transparent);
    color: rgba(var(--accent-2-rgb), 0.78);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.empty-state::after {
    content: "";
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 20px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(var(--accent-rgb), 0.18) 25%, rgba(var(--accent-2-rgb), 0.18) 75%, transparent 100%);
}

.empty-state-icon {
    font-size: 48px;
    margin-bottom: 16px;
    filter: drop-shadow(0 0 12px rgba(var(--accent-rgb), 0.18));
}

.empty-state-text {
    font-size: 15px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text-main) 88%, transparent);
}

.empty-state-text::before {
    content: "[ idle ] ";
    color: rgba(var(--accent-2-rgb), 0.72);
}

.empty-state-detail {
    margin-top: 12px;
    font-size: 12px;
    color: var(--text-soft);
    line-height: 1.7;
    letter-spacing: 0.04em;
}

/* ===== App Container ===== */
.app-container {
    display: none;
}

.app-container.connected {
    display: flex;
}

/* ===== Right Panel ===== */
.right-panel {
    position: fixed;
    right: 0;
    top: 0;
    width: 232px;
    height: 100vh;
    background: var(--right-panel-surface);
    border-left: 1px solid var(--line);
    z-index: 90;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
    scrollbar-width: thin;
    scrollbar-color: var(--sidebar-scrollbar-thumb) var(--sidebar-scrollbar-track);
}

.right-panel::-webkit-scrollbar {
    width: var(--sidebar-scrollbar-size);
}

.right-panel::-webkit-scrollbar-track {
    background: var(--sidebar-scrollbar-track);
}

.right-panel::-webkit-scrollbar-thumb {
    background: var(--sidebar-scrollbar-thumb);
    border-radius: var(--sidebar-scrollbar-radius);
}

.right-panel::-webkit-scrollbar-thumb:hover {
    background: var(--sidebar-scrollbar-thumb-hover);
}

.right-panel-section {
    padding: 20px 16px;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.08);
    position: relative;
}

.right-panel-section:last-child {
    border-bottom: none;
}

.right-panel-title {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-soft);
    font-weight: 700;
    margin-bottom: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
}

.right-panel-title::before {
    content: "module://";
    color: rgba(var(--accent-2-rgb), 0.72);
    letter-spacing: 0.2em;
}

.right-panel-title .icon {
    font-size: 14px;
}

.rp-task-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: none;
    overflow: visible;
}

.rp-task-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: var(--theme-task-surface);
    border: 1px solid transparent;
    transition: all 0.2s ease;
}

.rp-task-item.running {
    background: var(--theme-task-active-surface);
    border-color: rgba(var(--accent-rgb), 0.18);
}

.rp-task-item.done {
    opacity: 0.6;
}

.rp-task-item.skipped {
    opacity: 0.4;
}

.rp-status-icon {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    flex-shrink: 0;
    font-weight: 700;
}

.rp-status-icon.pending {
    background: color-mix(in srgb, var(--text-dim) 22%, transparent);
    color: var(--text-dim);
}

.rp-status-icon.running {
    background: rgba(var(--accent-rgb), 0.2);
    color: var(--accent);
    animation: pulse-icon 1.5s ease-in-out infinite;
}

@keyframes pulse-icon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.rp-status-icon.done {
    background: rgba(var(--accent-rgb), 0.14);
    color: var(--accent);
}

.rp-status-icon.skipped {
    background: rgba(var(--danger-rgb), 0.12);
    color: var(--accent-danger);
}

.rp-task-text {
    font-size: 12px;
    color: var(--text-main);
    font-weight: 600;
    line-height: 1.4;
    min-width: 0;
    flex: 1;
}

.rp-task-item.done .rp-task-text,
.rp-task-item.skipped .rp-task-text {
    text-decoration: line-through;
    color: var(--text-dim);
}

.rp-empty-state {
    text-align: center;
    padding: 24px 12px;
    color: var(--text-dim);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px dashed rgba(var(--accent-rgb), 0.12);
    border-radius: 8px;
    background: var(--theme-empty-surface-soft);
    position: relative;
    overflow: hidden;
}

.rp-empty-state::before {
    content: "task.queue::idle";
    display: block;
    margin-bottom: 8px;
    color: rgba(var(--accent-2-rgb), 0.72);
    letter-spacing: 0.16em;
}

.rp-empty-state::after {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 10px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(var(--accent-rgb), 0.18) 50%, transparent 100%);
}

.rp-summary-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.rp-summary-item {
    padding: 10px 12px;
    border-radius: 8px;
    background: var(--theme-summary-surface);
    border: 1px solid rgba(var(--accent-2-rgb), 0.1);
}

.rp-summary-label {
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 6px;
}

.rp-summary-value {
    font-size: 12px;
    color: var(--text-main);
    line-height: 1.4;
    word-break: break-word;
}

.rp-summary-status.ok,
.rp-context-status.ok {
    color: var(--accent);
}

.rp-summary-status.warning,
.rp-summary-status.warn,
.rp-context-status.warning,
.rp-context-status.warn {
    color: var(--accent-warn);
}

.rp-summary-status.critical,
.rp-summary-status.error,
.rp-context-status.critical,
.rp-context-status.error {
    color: var(--accent-danger);
}

.rp-context-status {
    font-size: 12px;
    letter-spacing: 0.12em;
    font-weight: 700;
}

.app-container {
    min-height: 100vh;
    min-height: 100dvh;
}

.mobile-panel-toggle,
.app-overlay {
    display: none;
}

@media (max-width: 1199px) {
    body {
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
        overflow-x: hidden;
    }

    body.overlay-open {
        overflow: hidden;
    }

    .sidebar,
    .main-content,
    .right-panel,
    .connection-page {
        height: 100vh;
        height: 100dvh;
    }

    .app-container.connected {
        position: relative;
        min-height: 100vh;
        min-height: 100dvh;
    }

.mobile-panel-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        position: fixed;
        top: 18px;
        z-index: 220;
        width: 48px;
        height: 48px;
        border-radius: 999px;
        border: 1px solid rgba(var(--accent-rgb), 0.24);
        background: var(--theme-mobile-toggle-surface);
        color: var(--text-main);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
        cursor: pointer;
        font-size: 20px;
        line-height: 1;
        backdrop-filter: blur(14px);
    }

    .mobile-panel-toggle-left {
        left: 16px;
    }

    .mobile-panel-toggle-right {
        right: 16px;
    }

.app-overlay {
        appearance: none;
        border: none;
        padding: 0;
        position: fixed;
        inset: 0;
        z-index: 180;
        background: var(--theme-mobile-overlay);
        backdrop-filter: blur(2px);
        cursor: pointer;
    }

    body.overlay-open .app-overlay {
        display: block;
    }

    .sidebar {
        width: min(320px, calc(100vw - 44px));
        max-width: 100%;
        transform: translateX(-100%);
        transition: transform 0.22s ease;
        z-index: 210;
    }

    body.sidebar-open .sidebar {
        transform: translateX(0);
    }

    .right-panel {
        width: min(360px, calc(100vw - 32px));
        max-width: 100%;
        transform: translateX(100%);
        transition: transform 0.22s ease;
        z-index: 210;
    }

    body.inspector-open .right-panel {
        transform: translateX(0);
    }

    .main-content {
        position: relative;
        left: auto;
        right: auto;
        top: auto;
        width: 100%;
        min-height: 100vh;
        min-height: 100dvh;
    }

    .page-header {
        padding: 24px 28px 20px;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 14px;
    }

    .page-header h1 {
        font-size: 22px;
        max-width: calc(100% - 120px);
        padding-top: 4px;
    }

    .page-header-actions {
        width: 100%;
        justify-content: flex-start;
        gap: 12px;
    }

    .page-content {
        padding: 28px 28px 32px;
    }
}

.theme-switcher-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--text-soft);
    text-transform: uppercase;
}

.theme-fab-switcher {
    position: fixed;
    left: 20px;
    bottom: 20px;
    z-index: 1100;
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: 12px;
    pointer-events: none;
}

.theme-fab,
.theme-switcher-menu {
    pointer-events: auto;
}

.theme-fab {
    width: 58px;
    height: 58px;
    border: 1px solid var(--theme-picker-border);
    border-radius: 999px;
    background: var(--theme-button-surface);
    color: var(--button-text);
    box-shadow: var(--button-shadow);
    backdrop-filter: blur(16px);
    cursor: pointer;
    font: inherit;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
}

.theme-fab:hover,
.theme-fab-switcher.open .theme-fab {
    transform: translate(-1px, -1px);
    box-shadow: var(--button-shadow-hover);
    color: var(--button-text-hover);
}

.theme-fab:focus-visible {
    outline: none;
    box-shadow: var(--control-shadow-focus), var(--button-shadow);
}

.theme-switcher-menu {
    width: min(220px, calc(100vw - 32px));
    padding: 14px;
    border: 1px solid var(--theme-picker-border);
    border-radius: 16px;
    background: var(--theme-picker-surface);
    box-shadow: var(--theme-picker-shadow);
    backdrop-filter: blur(16px);
}

.theme-switcher-menu[hidden] {
    display: none;
}

.theme-switcher-menu .theme-switcher-title {
    margin-bottom: 10px;
}

.theme-switcher-controls {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: stretch;
}

.theme-option-btn {
    width: 100%;
    min-height: 42px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--ghost-button-border);
    background: var(--ghost-button-surface);
    color: var(--ghost-button-text);
    box-shadow: var(--ghost-button-shadow);
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-align: left;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease, background 0.2s ease;
}

.theme-option-btn:hover {
    transform: translate(-1px, -1px);
    background: var(--ghost-button-surface-hover);
    color: var(--ghost-button-text-hover);
}

.theme-option-btn.active {
    border-color: var(--theme-button-border);
    background: var(--theme-button-surface);
    color: var(--button-text);
    box-shadow: var(--button-shadow);
}

.theme-option-btn:focus-visible {
    outline: none;
    box-shadow: var(--control-shadow-focus), var(--ghost-button-shadow);
}

@media (max-width: 1199px) {
    .theme-fab-switcher {
        left: 16px;
        bottom: 16px;
    }
}

@media (max-width: 767px) {
    .theme-fab-switcher {
        left: 14px;
        bottom: 14px;
    }

    .theme-fab {
        width: 52px;
        height: 52px;
        font-size: 11px;
    }

    .theme-switcher-menu {
        width: min(200px, calc(100vw - 28px));
        padding: 12px;
        border-radius: 14px;
    }
}

@media (max-width: 767px) {
    .mobile-panel-toggle {
        top: 14px;
        width: 44px;
        height: 44px;
    }

    .mobile-panel-toggle-left {
        left: 12px;
    }

    .mobile-panel-toggle-right {
        right: 12px;
    }

    .sidebar {
        width: min(304px, calc(100vw - 28px));
    }

    .right-panel {
        width: min(100vw, 420px);
    }

    .sidebar-header {
        padding-top: 20px;
    }

    .sidebar-nav {
        padding: 22px 12px 18px;
    }

    .nav-item {
        padding: 13px 14px;
    }

    .page-header {
        padding: 68px 16px 18px;
        gap: 12px;
    }

    .page-header h1 {
        font-size: 19px;
        max-width: 100%;
        line-height: 1.25;
    }

    .page-header-actions {
        gap: 10px;
    }

    .page-content {
        padding: 20px 16px 24px;
    }

    .action-btn {
        padding: 10px 16px;
        font-size: 12px;
    }

    .header-chip {
        letter-spacing: 0.12em;
    }
}
