var logEntryLinePattern = regexp.MustCompile(`^(\d{4}-\d{2}-\d{2}) (\d{2}:\d{2}:\d{2})\.\d{3}\s+([A-Z]+)\s+(?:\[[^\]]+\]\s+)?(.*)$`)
var ansiEscapePattern = regexp.MustCompile(`\x1b\[[0-9;]*m`)

