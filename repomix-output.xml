function sendWSRequest(action, extra) {
    extra = extra || {};
    if (!ws || ws.readyState !== WebSocket.OPEN) {
        addLog('warn', 'WebSocket not connected, cannot fetch ' + action);
        return false;
    }
    ws.send(JSON.stringify(Object.assign({ action: action }, extra)));
    return true;
}
