    border-color: var(--panel-info-border);
}

.diagnostics-status-text {
    color: var(--text-soft);
    font-size: 13px;
}

.diagnostics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
}

.diagnostics-kpi-card {
    background: var(--panel-card-surface);
    border: 1px solid var(--panel-card-border);
    border-radius: 16px;
    padding: 18px;
}

.diagnostics-kpi-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 12px;
}

.diagnostics-kpi-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.1;
}

.diagnostics-kpi-meta {
    margin-top: 10px;
    font-size: 12px;
    color: var(--text-soft);
}

.diagnostics-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(300px, 0.9fr);
    gap: 24px;
    align-items: start;
}

.diagnostics-main-column,
.diagnostics-side-column {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.diagnostics-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--panel-divider-soft);
}

.diagnostics-row:last-child {
    border-bottom: none;
}

.diagnostics-row-label {
    color: var(--text-soft);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.diagnostics-row-value {
    color: var(--text-main);
    font-size: 13px;
    text-align: right;
}

.diagnostics-table-shell {
    overflow-x: auto;
}

.diagnostics-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 620px;
}

.diagnostics-table th,
.diagnostics-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--panel-divider-soft);
    vertical-align: top;
    text-align: left;
    font-size: 13px;
}

.diagnostics-table th {
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 11px;
}

.diagnostics-cell-meta,
.diagnostics-subcopy {
    margin-top: 6px;
    color: var(--text-dim);
    font-size: 12px;
}

.diagnostics-empty-cell,
.diagnostics-empty-block {
    color: var(--text-dim);
    font-size: 13px;
}

.diagnostics-badge,
.diagnostics-inline-chip {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid var(--panel-info-border);
    color: var(--text-soft);
}

.diagnostics-badge.ok {
    color: var(--accent);
    border-color: var(--panel-success-border);
}

.diagnostics-badge.warning,
.diagnostics-badge.warn {
    color: var(--accent-warn);
    border-color: var(--panel-warn-border);
}

.diagnostics-badge.critical,
.diagnostics-badge.error {
    color: var(--accent-danger);
    border-color: var(--panel-danger-strong-border);
}

.diagnostics-inline-chip {
    margin-left: 8px;
}

.diagnostics-agent-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.diagnostics-agent-card {
    background: var(--panel-inline-surface);
    border: 1px solid var(--panel-inline-border);
    border-radius: 14px;
    padding: 16px;
}

.diagnostics-agent-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
}

.diagnostics-agent-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--text-main);
}

.diagnostics-agent-meta,
.diagnostics-agent-stats {
    margin-top: 6px;
    color: var(--text-soft);
    font-size: 12px;
}

.diagnostics-agent-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
}

.diagnostics-tool-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
}

.diagnostics-tool-chip {
    display: inline-flex;
    align-items: center;
    padding: 6px 10px;
    border-radius: 999px;
    font-size: 11px;
    border: 1px solid var(--panel-chip-border);
    color: var(--text-soft);
    background: var(--panel-chip-surface);
}

.diagnostics-tool-chip.session { border-color: var(--panel-success-border); }
.diagnostics-tool-chip.schedule { border-color: var(--panel-warn-border); }
.diagnostics-tool-chip.skill { border-color: color-mix(in srgb, var(--accent-2) 48%, var(--accent) 52%); }
.diagnostics-tool-chip.mcp { border-color: var(--panel-info-border); }
.diagnostics-tool-chip.plugin { border-color: var(--panel-danger-border); }
.diagnostics-tool-chip.more { opacity: 0.75; }

.diagnostics-mini-list,
.diagnostics-issue-list,
.diagnostics-inline-issues {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 14px;
}

.diagnostics-mini-item,
.diagnostics-issue-item,
.diagnostics-inline-issue {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 10px;
    background: var(--panel-inline-surface);
    border: 1px solid var(--panel-inline-border);
    color: var(--text-soft);
    font-size: 12px;
}

.diagnostics-issue-list.warning .diagnostics-issue-item,
.diagnostics-inline-issues.warning .diagnostics-inline-issue {
    border-color: var(--panel-warn-border);
}

.diagnostics-issue-list.error .diagnostics-issue-item,
.diagnostics-inline-issues.error .diagnostics-inline-issue {
    border-color: var(--panel-danger-border);
}

@media (max-width: 1100px) {
    .diagnostics-layout {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 720px) {
    .diagnostics-toolbar {
        align-items: flex-start;
    }

    .diagnostics-table {
        min-width: 0;
    }

    .diagnostics-grid {
        grid-template-columns: 1fr;
    }

    .diagnostics-row,
    .diagnostics-agent-header,
    .diagnostics-mini-item,
    .diagnostics-issue-item,
    .diagnostics-inline-issue {
        flex-direction: column;
        align-items: flex-start;
    }

    .diagnostics-row-value {
        text-align: left;
    }
}
</file>

<file path="web/css/logs.css">
/* ===== Logs ===== */
.log-controls {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
}

.log-filter {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid var(--control-border);
    background: var(--control-surface);
    box-shadow: var(--control-shadow-inset);
}

.log-filter-label {
    color: var(--text-dim);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
}

.log-level-select {
    appearance: none;
    -webkit-appearance: none;
    min-width: 150px;
    padding: 9px 38px 9px 12px;
    background:
        linear-gradient(45deg, transparent 50%, var(--select-arrow-top) 50%) calc(100% - 18px) calc(50% - 2px) / 6px 6px no-repeat,
        linear-gradient(135deg, var(--select-arrow-bottom) 50%, transparent 50%) calc(100% - 13px) calc(50% - 2px) / 6px 6px no-repeat,
        var(--control-surface);
    border: 1px solid var(--control-border);
    border-radius: 8px;
    color: var(--text-main);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    outline: none;
    cursor: pointer;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
}

.log-level-select:hover {
    border-color: var(--control-border-strong);
}

.log-level-select:focus {
    border-color: var(--control-border-strong);
    box-shadow: var(--control-shadow-focus);
}

.log-level-select option {
    background: var(--bg-0);
    color: var(--text-main);
}

.log-controls button {
    padding: 8px 14px;
    background: var(--ghost-button-surface);
    border: 1px solid var(--ghost-button-border);
    border-radius: 8px;
    color: var(--ghost-button-text);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.log-controls button:hover {
    background: var(--ghost-button-surface-hover);
    color: var(--ghost-button-text-hover);
    box-shadow: var(--ghost-button-shadow);
}

.log-container {
    background: var(--panel-card-surface);
    border: 1px solid var(--panel-card-border);
    border-radius: var(--radius-panel);
    padding: 16px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 13px;
    line-height: 1.6;
    max-height: calc(100vh - 200px);
    overflow-y: auto;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.log-entry {
    padding: 12px 14px;
    border-radius: 10px;
    /* background: rgba(11, 20, 34, 0.88); */
      background: var(--panel-card-surface);
    border: 1px solid rgba(var(--accent-rgb), 0.08);
    border-left: 3px solid rgba(var(--accent-rgb), 0.18);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.015);
}

.log-entry.info {
    color: var(--text-main);
}

.log-entry.warn {
    color: var(--accent-warn);
    background: var(--panel-warn-surface);
    border-color: var(--panel-warn-border);
    border-left-color: color-mix(in srgb, var(--accent-warn) 38%, transparent);
}

.log-entry.error {
    color: var(--panel-danger-text);
    background: var(--panel-danger-surface);
    border-color: var(--panel-danger-border);
    border-left-color: rgba(var(--danger-rgb), 0.32);
}

.log-entry-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--panel-divider-soft);
}

.log-time {
    color: var(--text-dim);
    min-width: 72px;
}

.log-level {
    font-weight: 700;
    letter-spacing: 0.08em;
}

.log-message {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    color: color-mix(in srgb, var(--text-main) 88%, transparent);
    font: inherit;
}

@media (max-width: 767px) {
    .log-controls {
        width: 100%;
        align-items: stretch;
    }

    .log-filter,
    .log-level-select,
    .log-controls button {
        width: 100%;
    }

    .log-container {
        max-height: calc(100dvh - 240px);
        padding: 12px;
    }

    .log-entry-header {
        flex-wrap: wrap;
        gap: 8px;
    }
}
</file>

<file path="web/css/schedules.css">
/* ===== Schedules ===== */
.schedule-layout {
    display: grid;
    grid-template-columns: minmax(320px, 420px) minmax(0, 1fr);
    gap: 24px;
    align-items: start;
}

.schedule-form-panel,
.schedule-list-panel .settings-section {
    min-height: 100%;
}

.schedule-list-panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.schedule-row-block {
    align-items: flex-start;
    gap: 20px;
}

.schedule-row-block .settings-label {
    padding-top: 10px;
}

.schedule-textarea {
    width: 100%;
    min-height: 180px;
    resize: vertical;
    line-height: 1.6;
    font-family: inherit;
}

.schedule-checkbox-row {
    justify-content: space-between;
}

.schedule-checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-soft);
    font-size: 13px;
    letter-spacing: 0.04em;
}

.schedule-checkbox-label input {
    accent-color: var(--accent);
}

.schedule-form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 18px;
}

.schedule-helper-row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 6px 0 14px;
}

.schedule-helper-text {
    color: var(--text-soft);
    font-size: 12px;
    line-height: 1.5;
}

.schedule-preset-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.settings-subsection-helper {
    margin: 0;
}

.schedule-item {
    align-items: flex-start;
    gap: 18px;
}

.schedule-actions {
    min-width: 140px;
    flex-direction: column;
    align-items: stretch;
}

.schedule-desc {
    margin-top: 10px;
    color: var(--text-soft);
    font-size: 13px;
    line-height: 1.6;
}

.schedule-prompt {
    margin-top: 12px;
    padding: 12px 14px;
    background: var(--panel-code-surface);
    border: 1px solid var(--panel-code-border);
    border-radius: 8px;
    color: var(--panel-code-text);
    font-size: 12px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
}

.schedule-runtime-meta {
    margin-top: 12px;
    color: var(--text-dim);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.schedule-runtime-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 12px;
}

.schedule-runtime-chip {
    padding: 10px 12px;
    border: 1px solid var(--panel-inline-border);
    border-radius: 8px;
    background: var(--panel-inline-surface);
}

.schedule-runtime-chip span {
    display: block;
    margin-bottom: 6px;
    color: var(--text-dim);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.schedule-runtime-chip code {
    display: block;
    color: color-mix(in srgb, var(--text-main) 92%, transparent);
    font-size: 12px;
    line-height: 1.5;
    white-space: pre-wrap;
    word-break: break-word;
}

.schedule-error {
    margin-top: 12px;
    padding: 10px 12px;
    border: 1px solid var(--panel-danger-border);
    background: var(--panel-danger-surface);
    border-radius: 8px;
    color: var(--panel-danger-text);
    font-size: 12px;
    line-height: 1.5;
}

.schedule-runs-panel {
    min-height: 260px;
}

.schedule-runs-header {
    margin-bottom: 14px;
    color: var(--text-soft);
    font-size: 12px;
    letter-spacing: 0.04em;
}

.schedule-runs-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.schedule-run-item {
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--panel-inline-border);
    background: var(--panel-inline-surface);
}

.schedule-run-success {
    border-color: var(--panel-success-border);
}

.schedule-run-skipped {
    border-color: var(--panel-warn-border);
}

.schedule-run-failed {
    border-color: var(--panel-danger-border);
}

.schedule-run-top {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 8px;
}

.schedule-run-status,
.schedule-run-trigger {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dim);
}

.schedule-run-meta {
    color: var(--text-soft);
    font-size: 12px;
    line-height: 1.6;
    word-break: break-word;
}

.schedule-run-error {
    margin-top: 8px;
    color: var(--panel-danger-text);
    font-size: 12px;
    line-height: 1.5;
}

@media (max-width: 1180px) {
    .schedule-layout {
        grid-template-columns: 1fr;
    }

    .schedule-actions {
        min-width: 0;
        width: 100%;
        flex-direction: row;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .schedule-runtime-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 767px) {
    .schedule-item {
        gap: 14px;
    }

    .schedule-actions {
        justify-content: stretch;
    }

    .schedule-actions .session-btn {
        flex: 1 1 140px;
    }

    .schedule-run-top,
    .schedule-checkbox-row,
    .schedule-row-block {
        flex-direction: column;
        align-items: flex-start;
    }
}
</file>

<file path="web/css/sessions.css">
/* ===== Sessions List ===== */
.sessions-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.session-item {
    background: var(--panel-card-surface);
    border: 1px solid var(--panel-card-border);
    border-radius: var(--radius-panel);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    backdrop-filter: blur(10px);
    transition: all 0.2s;
    cursor: pointer;
    position: relative;
}

.session-item:hover {
    border-color: var(--panel-card-hover-border);
    background: var(--panel-inline-surface);
    box-shadow: var(--panel-block-shadow-md);
}

.session-info {
    flex: 1;
}

.session-id {
    font-size: 15px;
    color: var(--text-main);
    margin-bottom: 6px;
    font-weight: 700;
    letter-spacing: 0.06em;
}

.session-meta {
    font-size: 12px;
    color: var(--text-soft);
}

.session-actions {
    display: flex;
    gap: 8px;
}

.session-btn {
    padding: 8px 14px;
    background: var(--ghost-button-surface);
    border: 1px solid var(--ghost-button-border);
    border-radius: 8px;
    color: var(--ghost-button-text);
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    letter-spacing: 0.1em;
}

.session-btn:hover {
    background: var(--ghost-button-surface-hover);
    color: var(--ghost-button-text-hover);
    box-shadow: var(--ghost-button-shadow);
}

.session-btn-danger {
    color: var(--panel-danger-text);
    border-color: var(--panel-danger-border);
    background: var(--panel-danger-surface);
}

.session-btn-danger:hover {
    background: var(--panel-danger-surface);
    color: color-mix(in srgb, var(--panel-danger-text) 86%, white);
}

@media (max-width: 767px) {
    .session-item {
        padding: 18px 16px;
        flex-direction: column;
        align-items: stretch;
        gap: 14px;
    }

    .session-actions {
        flex-wrap: wrap;
    }

    .session-btn {
        flex: 1 1 140px;
        text-align: center;
    }

    .session-meta {
        line-height: 1.6;
        word-break: break-word;
    }
}
</file>

<file path="web/css/settings.css">
/* ===== Settings ===== */
.settings-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
}

.settings-meta,
.settings-status {
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 12px;
    letter-spacing: 0.04em;
    border: 1px solid var(--panel-card-border);
    background: var(--panel-inline-surface);
    color: var(--text-soft);
}

.settings-status.pending {
    color: var(--accent-warn);
    border-color: var(--panel-warn-border);
}

.settings-status.success {
    color: var(--accent);
    border-color: var(--panel-success-border);
}

.settings-status.warn {
    color: var(--accent-2);
    border-color: var(--panel-info-border);
}

.settings-status.error {
    color: var(--accent-danger);
    border-color: var(--panel-danger-strong-border);
}

.settings-panel {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.settings-editor-header {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
    align-items: center;
}

.settings-editor-copy {
    color: var(--text-soft);
    font-size: 13px;
    line-height: 1.6;
}

.settings-dirty-hint {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
}

.settings-dirty-hint.clean {
    color: var(--text-dim);
}

.settings-dirty-hint.dirty {
    color: var(--accent-warn);
}

.settings-yaml-editor {
    width: 100%;
    min-height: 560px;
    padding: 16px;
    background: var(--panel-code-surface);
    border: 1px solid var(--panel-code-border);
    border-radius: 8px;
    color: var(--text-main);
    font-size: 13px;
    line-height: 1.6;
    resize: vertical;
    outline: none;
    font-family: inherit;
}

.settings-yaml-editor:focus {
    border-color: var(--control-border-strong);
}

.settings-issues {
    margin-top: 16px;
    padding: 14px 16px;
    border-radius: 8px;
    border: 1px solid var(--panel-danger-border);
    background: var(--panel-danger-surface);
    color: var(--panel-danger-text);
}

.settings-issues-title {
    margin-bottom: 10px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--panel-danger-text) 86%, white);
}

.settings-issues ul {
    margin: 0;
    padding-left: 18px;
}

.settings-issues li {
    margin: 6px 0;
    line-height: 1.5;
}

.settings-section {
    background: var(--panel-card-surface);
    border: 1px solid var(--panel-card-border);
    border-radius: var(--radius-panel);
    padding: 24px;
    backdrop-filter: blur(10px);
    position: relative;
}

.settings-section-title {
    font-size: 15px;
    color: var(--text-main);
    margin-bottom: 20px;
    font-weight: 700;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--panel-divider-soft);
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.settings-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
}

.settings-label {
    font-size: 13px;
    color: color-mix(in srgb, var(--text-main) 88%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.settings-value {
    font-size: 13px;
    color: var(--text-soft);
}

.settings-input {
    padding: 8px 12px;
    background: var(--control-surface);
    border: 1px solid var(--control-border);
    border-radius: 8px;
    color: var(--text-main);
    font-size: 13px;
    width: 200px;
    outline: none;
}

.settings-input:focus {
    border-color: var(--control-border-strong);
}

.settings-input option {
    background: var(--bg-0);
    color: var(--text-main);
}

.settings-field-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
    margin-top: 18px;
}

.settings-field-card {
    background: var(--panel-inline-surface);
    border: 1px solid var(--panel-inline-border);
    border-radius: 12px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.settings-field-card.has-error {
    border-color: var(--panel-danger-strong-border);
    box-shadow: 0 0 0 1px var(--panel-danger-border);
}

.settings-field-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: flex-start;
}

.settings-field-path {
    margin-top: 4px;
    font-size: 12px;
    color: var(--text-dim);
    font-family: Consolas, monospace;
}

.settings-field-description {
    margin-top: 6px;
    font-size: 12px;
