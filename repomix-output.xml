	if err := chromedp.Run(ctx, actions...); err != nil {
		return "", browserActionError("capture page snapshot", defaultBrowserActionTimeout, err)
	}

	if len(text) > 5000 {
		text = text[:5000] + "...(truncated)"
	}

	result := fmt.Sprintf("URL: %s\n\nContent:\n%s", url, text)
	return result, nil
}

