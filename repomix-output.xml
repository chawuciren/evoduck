		{name: "hostname", value: "api.internal"},
		{name: "empty", value: "", wantErr: true},
		{name: "contains space", value: "bad host", wantErr: true},
		{name: "contains scheme", value: "http://127.0.0.1", wantErr: true},
	}
	for _, tt := range tests {
