}

func (m *Manager) SetToolResultCondenseLimit(limit int) {
	if limit > 0 {
		m.toolResultCondenseLimit = limit
	}
}

func (m *Manager) SetImageAutoCompressLimit(limit int) {
	if limit > 0 {
		m.imageAutoCompressLimit = limit
	}
}

type Agent struct {
