			UpdatedAt:   entry.UpdatedAt.Format(time.RFC3339),
			Tags:        entry.Tags,
		})
	}

	resp := map[string]interface{}{
		"type":        "knowledge",
		"knowledge":   items,
		"directories": directories,
	}
	data, _ := json.Marshal(resp)
	g.writeWSJSON(conn, data, logger.Fields{"response_type": "knowledge"})
