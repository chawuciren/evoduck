    position: absolute;
    top: 8px;
    left: 40px;
    color: rgba(var(--accent-2-rgb), 0.55);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.chat-input-row {
    display: flex;
    align-items: flex-end;
    gap: 16px;
}

.chat-input-shell {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
}

.chat-input-shell::before {
    content: ">";
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--accent);
    font-weight: 700;
    z-index: 2;
    pointer-events: none;
}

.chat-input-shell input {
    width: 100%;
    padding-left: 34px;
}

.chat-input input {
    flex: 1;
    padding: 15px 20px;
    background: var(--control-surface);
    border: 1px solid var(--control-border);
    border-radius: var(--radius-input);
    font-size: 15px;
    color: var(--text-main);
    outline: none;
    transition: all 0.3s;
    backdrop-filter: blur(10px);
    box-shadow: var(--control-shadow-inset);
}

.chat-input input:focus {
    border-color: var(--control-border-strong);
    background: var(--control-surface-strong);
    box-shadow: var(--control-shadow-focus);
}

.chat-input input::placeholder {
    color: var(--text-dim);
    font-size: 14px;
}

.pending-media-tray {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
}

.pending-media-item {
    min-width: 180px;
    max-width: 240px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 12px;
    background: var(--control-surface);
    border: 1px solid rgba(var(--accent-2-rgb), 0.14);
    box-shadow: var(--control-shadow-inset);
}

.pending-media-item.uploading {
    border-color: color-mix(in srgb, var(--accent-warn) 35%, transparent);
}

.pending-media-item.failed {
    border-color: rgba(var(--danger-rgb), 0.35);
}

.pending-media-preview {
    width: 56px;
    height: 56px;
    border-radius: 10px;
    overflow: hidden;
    background: rgba(var(--theme-shadow-hard-rgb), 0.75);
    border: 1px solid rgba(var(--accent-rgb), 0.12);
    flex-shrink: 0;
}

.pending-media-preview img,
.pending-media-placeholder {
    width: 100%;
    height: 100%;
}

.pending-media-preview img {
    display: block;
    object-fit: cover;
}

.pending-media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--text-soft) 82%, transparent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
}

.pending-media-meta {
    min-width: 0;
    flex: 1;
}

.pending-media-name {
    color: var(--text-main);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.pending-media-status {
    margin-top: 4px;
    color: var(--text-soft);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.pending-media-item.uploading .pending-media-status {
    color: var(--accent-warn);
}

.pending-media-item.failed .pending-media-status {
    color: color-mix(in srgb, var(--accent-danger) 62%, white);
}

.pending-media-remove {
    min-width: 34px;
    width: 34px;
    height: 34px;
    padding: 0;
    border-radius: 999px;
    font-size: 18px;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: center;
}

.terminal-icon-btn.disabled {
    opacity: 0.5;
}

.chat-input button {
    padding: 14px 24px;
    background: var(--theme-button-surface);
    color: var(--button-text);
    border: 1px solid rgba(var(--accent-rgb), 0.35);
    border-radius: var(--radius-input);
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    box-shadow: var(--button-shadow);
    transition: all 0.2s;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.chat-input button.stop-btn {
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent-danger) 34%, var(--bg-2)) 0%, color-mix(in srgb, var(--accent-danger) 18%, var(--bg-0)) 100%);
    color: color-mix(in srgb, var(--accent-danger) 56%, white);
    border-color: rgba(var(--danger-rgb), 0.38);
    box-shadow: var(--button-shadow-stop);
}

.chat-input button:hover:not(:disabled) {
    transform: translate(-1px, -1px);
    box-shadow: var(--button-shadow-hover);
    color: var(--button-text-hover);
}

.chat-input button.stop-btn:hover:not(:disabled) {
    box-shadow: var(--button-shadow-stop-hover);
}

.chat-input button:disabled {
    background: var(--button-disabled-surface);
    color: var(--button-disabled-text);
    cursor: not-allowed;
    box-shadow: none;
    border: 1px solid var(--button-disabled-border);
}

/* ===== Agent Selector ===== */
.agent-selector {
    appearance: none;
    -webkit-appearance: none;
    padding: 10px 14px;
    padding-right: 38px;
    background:
        linear-gradient(45deg, transparent 50%, var(--select-arrow-top) 50%) calc(100% - 18px) calc(50% - 2px) / 6px 6px no-repeat,
        linear-gradient(135deg, var(--select-arrow-bottom) 50%, transparent 50%) calc(100% - 13px) calc(50% - 2px) / 6px 6px no-repeat,
        var(--control-surface);
    border: 1px solid var(--control-border);
    border-radius: var(--radius-input);
    font-size: 13px;
    color: var(--text-main);
    outline: none;
    cursor: pointer;
    min-width: 190px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    box-shadow: var(--control-shadow-inset);
}

.agent-selector:focus {
    border-color: var(--control-border-strong);
    background:
        linear-gradient(45deg, transparent 50%, var(--select-arrow-top) 50%) calc(100% - 18px) calc(50% - 2px) / 6px 6px no-repeat,
        linear-gradient(135deg, var(--select-arrow-bottom) 50%, transparent 50%) calc(100% - 13px) calc(50% - 2px) / 6px 6px no-repeat,
        var(--control-surface-strong);
    box-shadow: var(--control-shadow-focus);
}

.agent-selector option {
    background: var(--panel-strong);
    color: var(--text-main);
    padding: 8px;
}

/* ===== Typing Indicator ===== */
.typing-indicator {
    padding: 12px 40px;
    color: var(--accent);
    font-size: 12px;
    display: none;
    font-weight: 700;
    letter-spacing: 0.16em;
    background: color-mix(in srgb, var(--panel-strong) 94%, transparent);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(var(--accent-2-rgb), 0.1);
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.08);
    text-transform: uppercase;
}

.typing-indicator::before {
    content: "[status] stream:// ";
    color: rgba(var(--accent-2-rgb), 0.6);
}

.typing-indicator.active {
    display: block;
}

@media (max-width: 768px) {
    .chat-messages {
        padding: 20px 16px 16px;
    }

    .message {
        margin-bottom: 18px;
    }

    .message-content {
        max-width: 92%;
        padding: 14px 16px;
        font-size: 14px;
    }

    .log-message-content,
    .tool-call-card,
    .thinking-card {
        max-width: 100%;
    }

    .chat-scroll-bottom-btn {
        bottom: 132px;
        padding: 9px 14px;
        font-size: 11px;
        letter-spacing: 0.1em;
    }

    .typing-indicator {
        padding: 10px 16px;
        font-size: 11px;
    }

    .chat-input {
        padding: 18px 16px calc(18px + env(safe-area-inset-bottom, 0px));
        gap: 10px;
    }

    .chat-input::before {
        left: 16px;
    }

    .chat-input-row {
        flex-wrap: wrap;
        gap: 10px;
    }

    .chat-input-shell {
        order: 3;
        width: 100%;
    }

    .terminal-icon-btn {
        min-width: 48px;
        width: 48px;
        height: 48px;
        padding: 0;
        font-size: 18px;
    }

    #sendBtn {
        min-height: 48px;
        padding: 12px 18px;
        margin-left: auto;
    }

    .pending-media-tray {
        flex-direction: column;
        gap: 8px;
    }

    .pending-media-item {
        min-width: 100%;
        max-width: 100%;
        align-items: flex-start;
    }

    .pending-media-remove {
        align-self: flex-start;
    }

    .agent-selector {
        min-width: 100%;
    }

    .message-media-item img,
    .message-media-item video {
        max-height: 240px;
    }

    .message.assistant .message-content pre {
        padding: 12px;
    }
}

@media (max-width: 520px) {
    .chat-scroll-bottom-btn {
        bottom: 148px;
        width: calc(100% - 32px);
        justify-content: center;
    }

    .chat-input-row {
        display: grid;
        grid-template-columns: 48px 48px minmax(0, 1fr);
        align-items: stretch;
    }

    .chat-input-shell {
        order: initial;
        width: auto;
        grid-column: 1 / -1;
    }

    #sendBtn {
        grid-column: 3;
        width: 100%;
        min-height: 46px;
    }

    .message-content {
        max-width: 96%;
    }
}

/* ===== Command Dropdown ===== */
.command-dropdown {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    background: var(--overlay-surface-strong);
    border: 1px solid var(--line);
    border-radius: var(--radius-panel);
    margin-bottom: 8px;
    max-height: 320px;
    overflow-y: auto;
    box-shadow: var(--overlay-shadow);
    backdrop-filter: blur(20px);
    z-index: 100;
}

.command-item {
    padding: 12px 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.08);
    transition: all 0.2s;
    position: relative;
}

.command-item:last-child {
    border-bottom: none;
}

.command-item:hover, .command-item.selected {
    background: color-mix(in srgb, var(--accent) 8%, var(--panel-soft));
}

.command-item.selected {
    border-left: 3px solid var(--accent);
}

.command-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 16%, var(--panel-strong)) 0%, color-mix(in srgb, var(--accent-2) 8%, var(--panel-soft)) 100%);
    border: 1px solid rgba(var(--accent-rgb), 0.26);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    box-shadow: 3px 3px 0 rgba(var(--theme-shadow-hard-rgb), 0.85);
}

.command-info {
    flex: 1;
    min-width: 0;
}

.command-name {
    font-size: 14px;
    color: var(--text-main);
    font-weight: 700;
    margin-bottom: 2px;
    letter-spacing: 0.06em;
}

.command-desc {
    font-size: 12px;
    color: var(--text-soft);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.command-usage {
    font-size: 11px;
    color: rgba(var(--accent-2-rgb), 0.75);
    font-family: monospace;
    flex-shrink: 0;
}

.command-dropdown-header {
    padding: 10px 18px;
    font-size: 11px;
    color: var(--accent-2);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 700;
    border-bottom: 1px solid rgba(var(--accent-rgb), 0.12);
}

.command-dropdown-empty {
    padding: 20px;
    text-align: center;
    color: var(--text-dim);
    font-size: 14px;
}

.terminal-icon-btn {
    min-width: 56px;
    font-size: 18px;
    line-height: 1;
}

/* ===== Tool Call Cards ===== */
.tool-call-card {
    background: var(--tool-card-surface);
    border: 1px solid rgba(var(--accent-2-rgb), 0.16);
    border-radius: 10px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: all 0.2s ease;
    cursor: pointer;
    max-width: 85%;
    position: relative;
}

.tool-call-card:hover {
    border-color: rgba(var(--accent-2-rgb), 0.28);
    background: var(--tool-card-surface-hover);
}

.tool-call-card.running {
    border-color: color-mix(in srgb, var(--accent-warn) 34%, transparent);
    background: var(--tool-card-running-surface);
}

.tool-call-card.completed {
    border-color: rgba(var(--accent-rgb), 0.22);
}

.tool-call-card.error {
    border-color: rgba(var(--danger-rgb), 0.3);
    background: var(--tool-card-error-surface);
}

.tool-call-header {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    gap: 12px;
    user-select: none;
}

.tool-call-header::before {
    content: "exec://tool";
    font-size: 10px;
    color: rgba(var(--accent-2-rgb), 0.75);
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.tool-status-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    font-weight: 700;
    transition: all 0.3s ease;
}

.tool-status-icon.running {
    background: color-mix(in srgb, var(--accent-warn) 20%, transparent);
    color: var(--accent-warn);
    animation: tool-spin 1.5s linear infinite;
}

.tool-status-icon.completed {
    background: rgba(var(--accent-rgb), 0.2);
    color: var(--accent);
}

.tool-status-icon.error {
    background: rgba(var(--danger-rgb), 0.2);
    color: var(--accent-danger);
}

@keyframes tool-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.tool-call-header .tool-name {
    font-size: 13px;
    font-weight: 700;
    color: var(--text-main);
    min-width: 0;
    letter-spacing: 0.06em;
    text-transform: uppercase;
}

.tool-call-header .tool-params-summary {
    font-size: 12px;
    font-family: 'Consolas', 'Monaco', monospace;
    color: var(--text-dim);
    flex: 1;
    min-width: 0;
    margin-left: 8px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.tool-call-header .tool-time {
    font-size: 11px;
    color: var(--text-dim);
    flex-shrink: 0;
}

.tool-call-header .tool-duration {
    font-size: 11px;
    color: rgba(var(--accent-2-rgb), 0.72);
    flex-shrink: 0;
    font-family: 'Consolas', 'Monaco', monospace;
}

.tool-expand-indicator {
    font-size: 12px;
    color: color-mix(in srgb, var(--text-dim) 76%, transparent);
    flex-shrink: 0;
    transition: transform 0.3s ease;
}

.tool-call-card.expanded .tool-expand-indicator {
    transform: rotate(180deg);
}

.tool-call-body {
    display: none;
    padding: 0 16px 16px;
    animation: tool-body-fade 0.3s ease;
}

.tool-call-card.expanded .tool-call-body {
    display: block;
}

@keyframes tool-body-fade {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

.tool-call-params {
    margin-bottom: 12px;
}

.tool-call-params-title,
.tool-call-result-title {
    font-size: 10px;
    color: var(--text-soft);
    margin-bottom: 6px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
}

.tool-call-params-content,
.tool-call-result-content {
    background: color-mix(in srgb, var(--bg-0) 80%, transparent);
    border: 1px solid rgba(var(--accent-rgb), 0.08);
    border-radius: 8px;
    padding: 10px 12px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 12px;
    color: color-mix(in srgb, var(--text-main) 90%, transparent);
    line-height: 1.6;
    white-space: pre-wrap;
    word-break: break-word;
    overflow-x: auto;
    max-height: 200px;
    overflow-y: auto;
}

.tool-call-timestamp {
    font-size: 11px;
    color: color-mix(in srgb, var(--text-soft) 40%, transparent);
    margin-top: 8px;
    text-align: right;
}

/* ===== Thinking Cards ===== */
.thinking-card {
    background: var(--thinking-card-surface);
    border: 1px solid rgba(var(--accent-2-rgb), 0.16);
    border-radius: 10px;
    margin-bottom: 12px;
    overflow: hidden;
    transition: all 0.2s ease;
    cursor: pointer;
    max-width: 85%;
    position: relative;
}

.thinking-card:hover {
    border-color: rgba(var(--accent-2-rgb), 0.28);
    background: var(--thinking-card-surface-hover);
}

.thinking-card.expanded {
    border-color: rgba(var(--accent-2-rgb), 0.3);
}

.thinking-header {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    gap: 12px;
    user-select: none;
}

.thinking-phase {
    font-size: 10px;
    color: rgba(var(--accent-2-rgb), 0.75);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 2px 8px;
    border: 1px solid rgba(var(--accent-2-rgb), 0.18);
    border-radius: 999px;
}

.thinking-icon {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
    background: rgba(var(--accent-2-rgb), 0.18);
    color: var(--accent-2);
    transition: all 0.3s ease;
}

.thinking-icon.active {
    animation: thinking-pulse 2s ease-in-out infinite;
}

@keyframes thinking-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

.thinking-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--thinking-label-color);
    flex: 1;
    min-width: 0;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.thinking-time {
    font-size: 11px;
    color: var(--text-dim);
    flex-shrink: 0;
}

.thinking-expand {
    font-size: 12px;
    color: color-mix(in srgb, var(--text-dim) 76%, transparent);
    flex-shrink: 0;
    transition: transform 0.3s ease;
    margin-left: auto;
}

.thinking-card.expanded .thinking-expand {
    transform: rotate(180deg);
}

.thinking-body {
    display: none;
    padding: 0 16px 16px;
    animation: thinking-fade 0.3s ease;
}

.thinking-card.expanded .thinking-body {
    display: block;
}

@keyframes thinking-fade {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
}

.thinking-content {
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 12px;
    color: var(--thinking-content-color);
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
    max-height: 300px;
    overflow-y: auto;
}

/* ===== Markdown Rendering ===== */
.message.assistant .message-content h2 {
    color: var(--accent);
    font-size: 19px;
    margin: 16px 0 10px;
    font-weight: 700;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.message.assistant .message-content h3 {
    color: var(--text-main);
    font-size: 17px;
    margin: 14px 0 8px;
    font-weight: 700;
    line-height: 1.4;
}

.message.assistant .message-content h4 {
    color: var(--accent-2);
    font-size: 15px;
    margin: 12px 0 8px;
    font-weight: 700;
    line-height: 1.4;
}

.message.assistant .message-content p {
    margin: 8px 0;
    line-height: 1.7;
}

.message.assistant .message-content code {
    background: color-mix(in srgb, var(--bg-0) 82%, transparent);
    padding: 2px 8px;
    border-radius: 4px;
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 12px;
    color: color-mix(in srgb, var(--text-main) 92%, white);
    word-break: break-word;
    border: 1px solid rgba(var(--accent-rgb), 0.1);
}

.message.assistant .message-content pre {
    background: color-mix(in srgb, var(--bg-0) 82%, transparent);
    padding: 16px;
    border-radius: 8px;
    overflow-x: auto;
    margin: 12px 0;
    border: 1px solid rgba(var(--accent-2-rgb), 0.12);
}

.message.assistant .message-content pre code {
    background: none;
    padding: 0;
    color: color-mix(in srgb, var(--text-main) 90%, transparent);
    font-size: 13px;
    line-height: 1.6;
    display: block;
}

.message.assistant .message-content table {
    width: 100%;
    border-collapse: collapse;
    margin: 12px 0;
}

.message.assistant .message-content th,
.message.assistant .message-content td {
    padding: 8px 12px;
    border: 1px solid rgba(var(--accent-2-rgb), 0.15);
    text-align: left;
}

.message.assistant .message-content th {
    background: color-mix(in srgb, var(--panel-soft) 92%, transparent);
    color: var(--accent-2);
    font-weight: 700;
}

.message.assistant .message-content td {
    color: color-mix(in srgb, var(--text-main) 88%, transparent);
}

.message.assistant .message-content blockquote {
    border-left: 3px solid rgba(var(--accent-rgb), 0.4);
    padding-left: 16px;
    margin: 12px 0;
    color: var(--text-soft);
    font-style: italic;
}

.message.assistant .message-content ul,
.message.assistant .message-content ol {
    margin: 8px 0;
    padding-left: 24px;
}

.message.assistant .message-content li {
    margin: 4px 0;
    line-height: 1.6;
}

.message.assistant .message-content a {
    color: var(--accent-2);
    text-decoration: none;
    transition: all 0.2s;
}

.message.assistant .message-content a:hover {
    text-decoration: underline;
    color: color-mix(in srgb, var(--accent-2) 72%, white);
}

.message.assistant .message-content img {
    max-width: 100%;
    border-radius: 8px;
    margin: 8px 0;
    height: auto;
}

.message.assistant .message-content hr {
    border: none;
    border-top: 1px solid rgba(var(--accent-2-rgb), 0.2);
    margin: 16px 0;
}

.message.assistant .message-content strong {
    color: color-mix(in srgb, var(--text-main) 86%, white);
    font-weight: 600;
}

.message.assistant .message-content em {
    font-style: italic;
    color: color-mix(in srgb, var(--text-soft) 86%, white);
}

/* ===== Context Stats ===== */
.context-stats {
    margin-top: 14px;
    background: color-mix(in srgb, var(--panel-soft) 84%, transparent);
    border: 1px solid rgba(var(--accent-rgb), 0.12);
    border-radius: 10px;
    padding: 12px 14px;
}

.context-stats-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.token-usage {
    font-size: 12px;
    color: var(--text-main);
    font-weight: 700;
    font-family: 'Consolas', 'Monaco', monospace;
}

.usage-percent {
    font-size: 10px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
}

.usage-percent.ok {
    background: rgba(var(--accent-rgb), 0.18);
    color: var(--accent);
    border: 1px solid rgba(var(--accent-rgb), 0.25);
}

.usage-percent.warning {
    background: color-mix(in srgb, var(--accent-warn) 18%, transparent);
    color: var(--accent-warn);
    border: 1px solid color-mix(in srgb, var(--accent-warn) 25%, transparent);
}

.usage-percent.critical {
    background: rgba(var(--danger-rgb), 0.18);
    color: color-mix(in srgb, var(--accent-danger) 58%, white);
    border: 1px solid rgba(var(--danger-rgb), 0.25);
}

.context-bar {
    height: 8px;
    background: color-mix(in srgb, var(--bg-0) 80%, transparent);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 12px;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.3);
}

.context-bar-fill {
    height: 100%;
    border-radius: 4px;
    transition: width 0.5s ease;
    box-shadow: 0 0 10px rgba(var(--accent-rgb), 0.28);
}

.context-bar-fill.ok {
    background: linear-gradient(90deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 58%, white) 100%);
}

.context-bar-fill.warning {
    background: linear-gradient(90deg, var(--accent-warn) 0%, color-mix(in srgb, var(--accent-warn) 54%, white) 100%);
}

.context-bar-fill.critical {
    background: linear-gradient(90deg, var(--accent-danger) 0%, color-mix(in srgb, var(--accent-danger) 56%, white) 100%);
}

.context-stats-detail {
    font-size: 10px;
    color: var(--text-soft);
    margin-bottom: 12px;
    line-height: 1.5;
    font-family: 'Consolas', 'Monaco', monospace;
    border-top: 1px dashed rgba(var(--accent-rgb), 0.1);
    padding-top: 8px;
}

.context-layer-breakdown {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.context-layer-bar {
    display: flex;
    width: 100%;
    height: 6px;
    overflow: hidden;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-0) 72%, transparent);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.35);
}

.context-layer-segment {
    height: 100%;
    min-width: 2px;
}

.context-layer-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.context-layer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.context-layer-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    color: color-mix(in srgb, var(--text-main) 88%, transparent);
}

.context-layer-value {
    color: color-mix(in srgb, var(--text-main) 92%, transparent);
    white-space: nowrap;
}

.context-layer-share {
    color: color-mix(in srgb, var(--text-soft) 72%, transparent);
}

.context-layer-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.16);
}

.context-layer-summary {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: color-mix(in srgb, var(--text-soft) 72%, transparent);
    padding-top: 2px;
}

.layer-0 {
    background: linear-gradient(90deg, var(--accent) 0%, color-mix(in srgb, var(--accent) 58%, white) 100%);
}

.layer-1 {
    background: linear-gradient(90deg, var(--accent-2) 0%, color-mix(in srgb, var(--accent-2) 60%, white) 100%);
}

.layer-2 {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent-2) 62%, var(--accent)) 0%, color-mix(in srgb, var(--accent-2) 30%, white) 100%);
}

.layer-3 {
    background: linear-gradient(90deg, var(--accent-warn) 0%, color-mix(in srgb, var(--accent-warn) 48%, white) 100%);
}

.layer-4 {
    background: linear-gradient(90deg, var(--accent-danger) 0%, color-mix(in srgb, var(--accent-danger) 54%, white) 100%);
}

.layer-5 {
    background: linear-gradient(90deg, color-mix(in srgb, var(--text-dim) 88%, var(--accent-2)) 0%, color-mix(in srgb, var(--text-soft) 48%, white) 100%);
}

.compress-btn {
    width: 100%;
    padding: 10px 14px;
    background: var(--theme-button-surface);
    border: 1px solid rgba(var(--accent-rgb), 0.25);
    border-radius: 8px;
    color: var(--accent);
    font-size: 11px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.14em;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-transform: uppercase;
}

.compress-btn::before {
    content: "⚡";
    font-size: 14px;
}

.compress-btn:hover {
    border-color: rgba(var(--accent-rgb), 0.38);
    color: color-mix(in srgb, var(--text-main) 90%, white);
    transform: translate(-1px, -1px);
    box-shadow: 4px 4px 0 rgba(var(--theme-shadow-hard-rgb), 0.92), 0 0 16px rgba(var(--accent-rgb), 0.1);
}

.compress-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.compress-btn:disabled::before {
    content: "⏳";
}
