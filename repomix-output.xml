</plist>
`, execPath, configPath, DefaultDataDir(), DefaultDataDir())

	// Write plist file
	plistPath := filepath.Join(launchAgentsFolder, LaunchAgentName)
	err := os.WriteFile(plistPath, []byte(plistContent), 0644)
	if err != nil {
		return fmt.Errorf("write plist file: %w", err)
	}

	return nil
