[CmdletBinding()]
param()

$ErrorActionPreference = 'Stop'

$Owner = 'chawuciren'
$Repo = 'evoduck'
$BinName = 'evoduck.exe'
$InstallDir = if ($env:EVODUCK_INSTALL_DIR) { $env:EVODUCK_INSTALL_DIR } else { Join-Path $HOME '.local\bin' }

function Write-Log {
    param([string]$Message)
    Write-Host $Message
}

function Write-BrandHeader {
    Write-Host @'
                    ░░░░
                ██████████░░
              ██████████████░
            ████  ██  ████████░
            ████  ██  ██████████  ██░░
        ░░██████████████████████ ██▓▓
      ░░██████████████▓▓██████▓▓
      ███████████████▓▓▓▓██████░
