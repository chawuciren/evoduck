func newEchoToolTestManager(t *testing.T, requestTimeout int) *Manager {
	t.Helper()
	port := freeTCPPort(t)
	pluginPath := filepath.Clean(filepath.Join("..", "..", "plugins", "echo-tool"))
	return NewManager(config.PluginConfig{
		WSServer: config.WSServerConfig{
			Host: "127.0.0.1",
