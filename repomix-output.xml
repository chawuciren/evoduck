    border: 1px solid rgba(var(--accent-rgb), 0.18);
    background: rgba(var(--theme-shadow-hard-rgb), 0.72);
    object-fit: contain;
}

.message-media-item audio {
    width: 100%;
    max-width: 320px;
}

.message-media-item a {
    color: color-mix(in srgb, var(--accent-2) 84%, white);
    text-decoration: none;
    word-break: break-word;
}

.message-media-item a:hover {
    text-decoration: underline;
}

.message.log-entry {
    justify-content: flex-start;
    margin-bottom: 12px;
}

.log-message-content {
    max-width: 85%;
    padding: 12px 18px;
    border-radius: 8px;
    background: var(--log-entry-surface);
    border-left: 3px solid rgba(var(--accent-rgb), 0.28);
    box-shadow: var(--log-entry-shadow);
}

.message.log-entry.thinking .log-message-content {
    background: var(--log-entry-thinking-surface);
    border-left-color: var(--accent-2);
}

.message.log-entry.tool-start .log-message-content {
    background: var(--log-entry-warn-surface);
    border-left-color: var(--accent-warn);
}

.message.log-entry.tool-end .log-message-content {
    background: var(--log-entry-success-surface);
    border-left-color: var(--accent);
}

.message.log-entry.iteration {
    margin-bottom: 4px;
}

.message.log-entry.iteration .log-message-content {
    background: transparent;
