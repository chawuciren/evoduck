/* ===== Chat Messages ===== */
.chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 40px;
    background: linear-gradient(180deg, rgba(var(--theme-shadow-hard-rgb), 0.2) 0%, rgba(var(--theme-shadow-hard-rgb), 0.06) 100%);
    position: relative;
}

.chat-scroll-bottom-btn {
    position: absolute;
    left: 50%;
    bottom: 116px;
    transform: translate(-50%, 16px);
    z-index: 12;
    border: 1px solid rgba(var(--accent-2-rgb), 0.3);
    background: color-mix(in srgb, var(--panel-strong) 94%, transparent);
    color: var(--text-main);
    padding: 10px 16px;
    border-radius: 999px;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.18);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
}

.chat-scroll-bottom-btn::before {
    content: "\2193";
    margin-right: 8px;
    color: rgba(var(--accent-rgb), 0.88);
}

.chat-scroll-bottom-btn.visible {
    opacity: 1;
    pointer-events: auto;
    transform: translate(-50%, 0);
}

.chat-scroll-bottom-btn:hover {
    background: color-mix(in srgb, var(--panel) 96%, transparent);
    border-color: rgba(var(--accent-rgb), 0.45);
}

.chat-messages::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(var(--accent-rgb), 0.025) 0%, transparent 20%, transparent 80%, rgba(var(--accent-2-rgb), 0.025) 100%);
    pointer-events: none;
}

.chat-messages::-webkit-scrollbar {
    width: 12px;
}

.chat-messages::-webkit-scrollbar-track {
    background: var(--content-scrollbar-track);
}

.chat-messages::-webkit-scrollbar-thumb {
    background: var(--content-scrollbar-thumb);
    border-radius: var(--content-scrollbar-radius);
    border: var(--content-scrollbar-thumb-border);
}

.chat-messages::-webkit-scrollbar-thumb:hover {
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 76%, white) 0%, color-mix(in srgb, var(--accent-2) 82%, white) 100%);
}

.chat-messages::-webkit-scrollbar-corner {
    background: var(--content-scrollbar-track);
}

.message {
    margin-bottom: 24px;
    display: flex;
    animation: fadeIn 0.3s ease;
    position: relative;
    z-index: 1;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(15px); }
    to { opacity: 1; transform: translateY(0); }
}

.message.user {
    justify-content: flex-end;
}

.message-content {
    max-width: 65%;
    padding: 16px 22px;
    border-radius: var(--radius-panel);
    line-height: 1.7;
    position: relative;
    backdrop-filter: blur(10px);
    font-size: 15px;
    border: 1px solid var(--line);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
}

.message-content::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(var(--accent-rgb), 0.5) 30%, rgba(var(--accent-2-rgb), 0.4) 70%, transparent 100%);
    pointer-events: none;
}

.message.user .message-content {
    background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.22) 0%, color-mix(in srgb, var(--panel-strong) 98%, transparent) 100%);
    color: color-mix(in srgb, var(--text-main) 92%, white);
    border: 1px solid rgba(var(--accent-rgb), 0.45);
    box-shadow: 0 0 24px rgba(var(--accent-rgb), 0.12), 4px 4px 0 rgba(var(--theme-shadow-hard-rgb), 0.85);
}

.message.user .message-content::after {
    content: "> user_input";
    display: block;
    margin-bottom: 10px;
    color: rgba(var(--accent-rgb), 0.72);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
}

.message.assistant .message-content {
    background: linear-gradient(180deg, color-mix(in srgb, var(--panel-strong) 92%, transparent) 0%, color-mix(in srgb, var(--panel-soft) 90%, transparent) 100%);
    color: var(--text-main);
    border: 1px solid rgba(var(--accent-2-rgb), 0.2);
    box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb), 0.05), var(--shadow-soft);
}

.message.assistant .message-content::after {
