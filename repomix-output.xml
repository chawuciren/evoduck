        <string>start</string>
        <string>--config</string>
        <string>%s</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <key>StandardOutPath</key>
    <string>%s/logs/evoduck.log</string>
    <key>StandardErrorPath</key>
    <string>%s/logs/evoduck.log</string>
