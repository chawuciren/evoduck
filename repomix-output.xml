<file path="web/css/knowledge.css">
/* ===== Knowledge List ===== */
.knowledge-list {
    display: flex;
    flex-direction: column;
    gap: 24px;
}

.knowledge-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, 1.1fr);
    gap: 24px;
    align-items: start;
}

.knowledge-browser-panel,
.knowledge-editor-panel {
    min-width: 0;
}

.knowledge-browser-shell {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.knowledge-toolbar {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
}

.knowledge-toolbar-input {
    min-width: 220px;
    flex: 1;
}

.knowledge-directory-context {
    margin-top: -4px;
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.6;
}

.knowledge-filters {
    display: grid;
    grid-template-columns: minmax(180px, 0.9fr) minmax(0, 1.1fr);
    gap: 16px;
}

.knowledge-filter-block {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
}

.knowledge-filter-label {
    font-size: 11px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.14em;
}

.knowledge-tree {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.knowledge-tree-root,
