/* ===== Chat Input ===== */
.chat-input {
    padding: 24px 40px 30px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-1) 42%, transparent) 0%, var(--overlay-surface-strong) 100%);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 10;
    box-shadow: inset 0 1px 0 rgba(var(--accent-2-rgb), 0.05), 0 -10px 24px rgba(var(--theme-shadow-hard-rgb), 0.08);
}

.chat-input::before {
