    align-items: center;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid var(--panel-warn-border);
    color: var(--accent-warn);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    white-space: nowrap;
}

.settings-field-input {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.settings-input-wide,
.settings-json-editor {
    width: 100%;
}

.settings-json-editor {
    min-height: 180px;
    padding: 12px;
    background: var(--panel-code-surface);
    border: 1px solid var(--panel-code-border);
    border-radius: 8px;
    color: var(--text-main);
    font-size: 12px;
    line-height: 1.6;
    resize: vertical;
    outline: none;
    font-family: Consolas, monospace;
}

.settings-json-editor:focus {
    border-color: var(--control-border-strong);
}

.settings-secret-input {
    letter-spacing: 0.12em;
    font-family: Consolas, monospace;
}

.settings-complex-editor {
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.settings-complex-toolbar,
.settings-subsection-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
}

.settings-complex-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 14px;
    border-radius: 10px;
    border: 1px solid var(--panel-card-border);
    background: var(--panel-inline-surface);
}

.settings-complex-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.settings-complex-title,
.settings-subsection-title,
.settings-inline-label {
    color: var(--text-main);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
}

.settings-complex-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
}

.settings-stack-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.settings-stack-field-span {
    grid-column: 1 / -1;
}

.settings-subsection {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--panel-divider);
}

.settings-inline-toggle-group {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
}

.settings-kv-row {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) minmax(180px, 2fr) auto;
    gap: 10px;
    align-items: center;
}

.settings-kv-key {
    opacity: 0.72;
}

.settings-inline-btn {
    white-space: nowrap;
}

.settings-empty-inline {
    color: var(--text-dim);
    font-size: 12px;
    line-height: 1.5;
}

.settings-subsection-title {
    color: var(--text-soft);
}

.settings-toggle {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-soft);
    font-size: 13px;
}

.settings-toggle input {
    accent-color: var(--accent);
}

.settings-field-errors {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.settings-field-error {
    color: var(--panel-danger-text);
    font-size: 12px;
    line-height: 1.4;
}

@media (max-width: 767px) {
    .settings-toolbar,
    .settings-editor-header,
    .settings-complex-toolbar,
    .settings-subsection-header,
    .settings-field-header,
    .settings-complex-card-header,
    .settings-row,
    .settings-kv-row {
        flex-direction: column;
        align-items: flex-start;
    }

    .settings-row {
        gap: 10px;
    }

    .settings-input,
    .settings-field-grid,
    .settings-complex-grid,
    .settings-json-editor,
    .settings-yaml-editor {
        width: 100%;
    }

    .settings-field-grid,
    .settings-complex-grid,
    .settings-kv-row {
        grid-template-columns: 1fr;
    }

    .settings-section {
        padding: 18px;
    }

    .settings-yaml-editor {
        min-height: 360px;
    }
}
