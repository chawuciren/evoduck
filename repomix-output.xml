func TestSkillUseReplacesBaseDirPlaceholder(t *testing.T) {
	tempDir := t.TempDir()
	agentSkillsDir := filepath.Join(tempDir, "skills")
	writeSkillFixture(t, agentSkillsDir, "with-supporting-files", `---
