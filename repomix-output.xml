    gemini:
      type: gemini
      api_key: ${GEMINI_API_KEY}
      default_model: gemini-2.5-flash
      models:
        - id: gemini-2.5-flash
          name: gemini-2.5-flash
          type: chat
          capabilities:
            vision: true
            reasoning: true
            tool_use: true
          context_window: 1048576
          max_output_tokens: 65536

    ollama:
      type: ollama
      base_url: http://localhost:11434/v1
      default_model: qwen2.5
      models:
        - id: qwen2.5
          name: qwen2.5
          type: chat
          capabilities:
            vision: true
